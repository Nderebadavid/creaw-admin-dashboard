# Base URL of vsla-identity-service (server-only -- never exposed to the
# browser). Used by the Next.js route handlers under src/app/api/auth/ that
# proxy login/logout, e.g. https://vsla-identity-service-dev.egroup.co.ke/api/v1
IDENTITY_SERVICE_BASE_URL=

PORTAL_API_MODE=mock
PORTAL_API_BASE_URL=
PORTAL_API_TIMEOUT_MS=10000
