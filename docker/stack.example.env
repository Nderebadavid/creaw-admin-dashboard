# Template for the server-only stack.development.env / stack.production.env files that
# docker-compose.yml loads. Copy it on the server, fill in real values, and never commit
# the copy (stack.*.env is git-ignored). Keep secrets out of this example.
ENV=development
# mock serves fixture data; live calls the portal API at PORTAL_API_BASE_URL.
PORTAL_API_MODE=live
PORTAL_API_BASE_URL=https://portal-api.example.com
PORTAL_API_TIMEOUT_MS=10000
PORTAL_API_UTC_OFFSET=+03:00
